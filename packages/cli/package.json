{
  "name": "@dino-hq/cli",
  "version": "0.3.0",
  "type": "module",
  "description": "Dino CLI — autonomous API quality scanner. Scan, document, diff, lint, and monitor your APIs.",
  "license": "MIT",
  "bin": {
    "dino": "dist/bin.js"
  },
  "files": [
    "dist/bin.js",
    "SECURITY.md",
    "LICENSE",
    "README.md",
    "schema.json"
  ],
  "scripts": {
    "build": "tsc --build",
    "bundle": "node build.mjs",
    "prepublishOnly": "cp ../../SECURITY.md . && node build.mjs",
