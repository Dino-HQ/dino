    "lint": "echo \"No lint yet\""
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Dino-HQ (https://usedino.dev)",
  "contributors": [
    {
      "name": "Dennis Mary",
      "url": "https://github.com/dennismary"
    }
  ],
  "keywords": [
