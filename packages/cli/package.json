    "graphql",
    "testing",
    "documentation",
    "cli",
    "dino",
    "api-testing",
    "schema-validation",
    "api-quality",
    "autonomous-qa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dino-HQ/dino.git",
    "directory": "packages/cli"
  },
  "homepage": "https://usedino.dev",
  "bugs": {
    "url": "https://github.com/Dino-HQ/dino/issues"
  },
  "devDependencies": {
    "@dino/agents": "*",
